{
    "dataset_type": "speech_translation_multitask",
    "data_path": "NhutP/VietSpeech",
    "audio_encoder_name": "UsefulSensors/moonshine-streaming-medium",
    "task_tokens": [
        "<vi_en>",
        "<vi_zh>",
        "<vi_ko>"
    ],
    "max_length": 64,
    "packing": false,
    "batch_by_tokens": false,
    "num_diffusion_timesteps": 50,
    "diffusion_type": "absorbing",
    "pretrained": "FacebookAI/xlm-roberta-base",
    "cache_dir": "cache",
    "attention_strategy": "full",
    "vocab_pad_to_multiple": 1,
    "lora": false,
    "output_dir": "outputs/remasker_mock_joint",
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "dataloader_num_workers": 0,
    "dataloader_pin_memory": true,
    "gradient_accumulation_steps": 1,
    "max_steps": 2,
    "do_eval": false,
    "eval_strategy": "no",
    "eval_steps": 100,
    "eval_metric": "wer",
    "eval_metrics": [
        "bleu",
        "wer"
    ],
    "load_best_model_at_end": false,
    "metric_for_best_model": "wer",
    "greater_is_better": false,
    "logging_steps": 1,
    "save_steps": 2,
    "save_total_limit": 1,
    "report_to": "none",
    "wandb_project": "diffusion-speech-recognition",
    "run_name": "remasker_mock_joint",
    "log_level": "info",
    "remove_unused_columns": false,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "adam_beta1": 0.9,
    "adam_beta2": 0.98,
    "lr_scheduler_type": "cosine",
    "warmup_steps": 0,
    "bf16": true,
    "bf16_full_eval": true,
    "label_smoothing_factor": 0,
    "mask_ratio_sampler": "diffusion",
    "train_length": false,
    "weighting": "linear",
    "mask_on_source": false,
    "mask_on_paddings": false,
    "max_iterations": 10,
    "mbr": 1,
    "length_beam": 1,
    "oracle_length": true,
    "strategy": "reparam-uncond-deterministic-cosine",
    "argmax_decoding": true,
    "bpe": "sentencepiece",
    "bleu_tokenize": "13a",
    "return_history": false,
    "temperature": 1.0,
    "push_to_hub": false,
    "hub_model_id": "aiai-laboratory/discrete-diffusion-vi-multitask",
    "translated_data_path": "aiai-laboratory/vietspeech-validation-translated",
    "translated_data_split": "validation",
    "max_dataset_samples": 32,
    "learned_remasking": true,
    "remask_training_stage": "joint",
    "remask_rollout_steps": 3,
    "remask_threshold": 0.5,
    "remask_loss_weight": 1.0,
    "remask_reconstruction_weight": 1.0,
    "save_strategy": "no",
    "finetune_from_model": "outputs/remasker_mock_detector/checkpoint-2"
}
