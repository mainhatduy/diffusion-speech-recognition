{
    "dataset_type": "speech_translation_multitask",
    "data_path": "NhutP/VietSpeech",
    "audio_encoder_name": "UsefulSensors/moonshine-streaming-medium",
    "task_tokens": [
        "<vi_en>"
    ],
    "max_length": 64,
    "packing": false,
    "precomputed_data_dir": "",
    "streaming": false,
    "use_ram_cache": true,
    "ram_free_threshold_ratio": 0.30,
    "batch_by_tokens": false,

    "num_diffusion_timesteps": 50,
    "diffusion_type": "absorbing",
    "pretrained": "FacebookAI/xlm-roberta-base",
    "cache_dir": "cache",
    "attention_strategy": "full",
    "vocab_pad_to_multiple": 1,
    "lora": false,
    "audio_fusion_strategy": "deep_cross_attn",

    "num_ergodic_layers": 6,
    "num_ergodic_cross_attn_layers": 6,
    "num_queries": 32,
    "num_resampler_layers": 2,
    "resampler_nhead": 8,
    "ergodic_window_left": 64,
    "ergodic_window_right": 16,
    "num_position_layers": 6,
    "position_window_left": 128,
    "position_window_right": 32,
    "rope_theta": 10000.0,

    "active_window_size": 64,
    "frozen_cache_size": 128,
    "streaming_denoise_steps": 3,
    "freeze_confidence_threshold": 0.92,
    "remask_confidence_threshold": 0.30,

    "loss_weight_supported": 2.0,
    "loss_weight_unsupported": 0.3,
    "use_confidence_calibration": true,
    "audio_chunk_duration": 2.0,
    "audio_overlap_duration": 0.5,

    "output_dir": "outputs/streaming_vi_multitask",
    "per_device_train_batch_size": 64,
    "per_device_eval_batch_size": 32,
    "dataloader_num_workers": 16,
    "dataloader_pin_memory": true,
    "dataloader_prefetch_factor": 4,
    "dataloader_persistent_workers": true,
    "gradient_accumulation_steps": 2,
    "max_steps": 100000,
    "do_eval": true,
    "eval_strategy": "steps",
    "eval_steps": 5000,
    "eval_metric": "wer",
    "eval_metrics": [
        "bleu",
        "wer"
    ],
    "load_best_model_at_end": true,
    "metric_for_best_model": "bleu",
    "greater_is_better": false,
    "logging_steps": 200,
    "save_steps": 5000,
    "save_total_limit": 3,
    "report_to": "wandb",
    "wandb_project": "diffusion-speech-recognition",
    "run_name": "streaming_vi_multitask_v1",
    "log_level": "info",
    "remove_unused_columns": false,

    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "adam_beta1": 0.9,
    "adam_beta2": 0.98,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.05,
    "max_grad_norm": 1.0,
    "bf16": true,
    "bf16_full_eval": true,
    "label_smoothing_factor": 0,
    "mask_ratio_sampler": "diffusion",
    "train_length": false,
    "weighting": "linear",
    "mask_on_source": false,
    "mask_on_paddings": false,

    "max_iterations": 10,
    "mbr": 1,
    "length_beam": 1,
    "oracle_length": true,
    "strategy": "reparam-uncond-deterministic-cosine",
    "argmax_decoding": true,
    "bpe": "sentencepiece",
    "bleu_tokenize": "13a",
    "return_history": false,
    "temperature": 1.0,

    "curriculum_training": true,
    "streaming_augmentation": true,

    "push_to_hub": false,
    "hub_model_id": "aiai-laboratory/streaming-diffusion-vi-multitask"
}
