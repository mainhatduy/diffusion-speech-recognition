{
    "dataset_type": "speech_translation_multitask",
    "data_path": "NhutP/VietSpeech",
    "audio_encoder_name": "UsefulSensors/moonshine-streaming-medium",
    "task_tokens": [
        "<vi_en>"
    ],
    "max_length": 128,
    "packing": false,
    "precomputed_data_dir": "",
    "stream_dataset_from_hub": true,
    "streaming_repo_id": "aiai-laboratory/vietspeech-train-streaming",
    "streaming_buffer_size": 1000,
    "val_streaming_size": 500,
    "ignore_data_skip": true,
    "batch_by_tokens": false,
    "num_diffusion_timesteps": 50,
    "diffusion_type": "absorbing",
    "pretrained": "FacebookAI/xlm-roberta-base",
    "cache_dir": "cache",
    "attention_strategy": "full",
    "vocab_pad_to_multiple": 1,
    "lora": false,
    "output_dir": "outputs/vi_en_streaming_generator",
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "dataloader_num_workers": 0,
    "dataloader_pin_memory": false,
    "gradient_accumulation_steps": 16,
    "max_steps": 50000,
    "do_eval": false,
    "eval_strategy": "no",
    "eval_steps": 5000,
    "eval_metric": "wer",
    "eval_metrics": [
        "bleu",
        "wer"
    ],
    "load_best_model_at_end": false,
    "metric_for_best_model": "bleu",
    "greater_is_better": true,
    "logging_steps": 50,
    "save_steps": 1000,
    "save_total_limit": 3,
    "report_to": "none",
    "wandb_project": "diffusion-speech-recognition",
    "run_name": "vi_en_streaming_generator",
    "log_level": "info",
    "remove_unused_columns": false,
    "learning_rate": 5e-05,
    "weight_decay": 0.01,
    "adam_beta1": 0.9,
    "adam_beta2": 0.98,
    "lr_scheduler_type": "cosine",
    "warmup_steps": 2500,
    "bf16": true,
    "bf16_full_eval": true,
    "label_smoothing_factor": 0,
    "mask_ratio_sampler": "diffusion",
    "train_length": false,
    "weighting": "linear",
    "mask_on_source": false,
    "mask_on_paddings": false,
    "max_iterations": 10,
    "mbr": 1,
    "length_beam": 1,
    "oracle_length": true,
    "strategy": "reparam-uncond-deterministic-cosine",
    "argmax_decoding": true,
    "bpe": "sentencepiece",
    "bleu_tokenize": "13a",
    "return_history": false,
    "temperature": 1.0,
    "push_to_hub": false,
    "hub_model_id": "aiai-laboratory/discrete-diffusion-vi-en",
    "enable_streaming_architecture": false,
    "use_ram_cache": false,
    "learned_remasking": false,
    "remask_training_stage": "disabled",
    "audio_fusion_strategy": "prefix",
    "max_grad_norm": 1.0,
    "save_strategy": "steps"
}
